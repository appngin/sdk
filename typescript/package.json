{
	"name": "@appnginhq/sdk",
	"version": "0.1.2",
	"description": "TypeScript SDK for the AppNgin API.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/appngin/sdk.git",
		"directory": "typescript"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./generated": {
			"types": "./dist/generated/index.d.ts",
			"import": "./dist/generated/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"generate": "openapi-ts -i ../spec/openapi.json -o ./src/generated -c @hey-api/client-fetch",
		"build": "bun run generate && bunx tsc -p tsconfig.json && bun build src/index.ts --outdir dist --target browser --format esm --sourcemap=external && bun build src/generated/index.ts --outdir dist/generated --target browser --format esm --sourcemap=external",
		"test": "bun test",
		"test:package": "node scripts/smoke-package.mjs",
		"prepack": "bun run build",
		"pack": "bun run build && bun pm pack --dry-run --ignore-scripts",
		"contract:fetch": "bun run scripts/fetch-contract.ts",
		"version:set": "bun run scripts/set-sdk-version.ts",
		"contract:lint": "bunx redocly lint ../spec/openapi.json"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"@hey-api/openapi-ts": "^0.99.0",
		"@redocly/cli": "^2.52.1",
		"typescript": "^5.9.3"
	},
	"keywords": [
		"appngin",
		"sdk",
		"typescript",
		"cloud",
		"http"
	]
}
